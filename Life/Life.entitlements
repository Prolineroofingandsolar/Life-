<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- No `com.apple.developer.healthkit.access` key, deliberately.
	     `health-records` is clinical data — lab results, medications,
	     immunisations from a healthcare provider — and Life reads none of it:
	     HealthKitManager asks only for standard quantity and category types.
	     It is a restricted capability that automatic signing cannot provision
	     unless the App ID is specially approved, so requesting it produced
	     repeated Signing & Capabilities failures on device builds. Plain
	     HealthKit provisions cleanly. -->
	<!-- Required for HKObserverQuery to wake the app in the background.
	     Without it the observers only fire while Life is in the foreground,
	     which is the feature not working rather than an error. -->
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.uk.co.prolineroofingandsolar.life</string>
	</array>
</dict>
</plist>
