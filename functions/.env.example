# Copy to functions/.env.<projectId> and fill in. Never commit the real file —
# .gitignore already excludes it.
#
# The API keys are NOT set here. They are Cloud Functions secrets, stored in
# Secret Manager, set once each with:
#
#   firebase functions:secrets:set XAI_API_KEY      (Grok, from console.x.ai)
#   firebase functions:secrets:set GEMINI_API_KEY   (Gemini, from AI Studio)
#
# Both must exist for the deploy to succeed, even though only the provider
# below is used. If you never use Gemini, set GEMINI_API_KEY to any
# placeholder.
#
# Everything below is ordinary configuration and safe to keep in the env file.

# Which provider answers the coach: grok or gemini.
COACH_PROVIDER=grok

# The exact Grok model identifier from xAI's current docs (docs.x.ai/docs/models).
# Pick a fast, non-reasoning model that supports structured outputs and image
# input: reasoning models spend the output budget thinking and can get cut off.
GROK_MODEL=

# Used only to estimate spend against the ceiling below. Check these against
# xAI's current pricing for the model you chose.
GROK_INPUT_PRICE_PER_MILLION=0.20
GROK_OUTPUT_PRICE_PER_MILLION=0.50

# The exact Gemini model identifier from Google's current documentation. Deliberately
# left blank: model names change, and a stale hardcoded one is a future outage.
GEMINI_MODEL=

# Requests allowed per user per rolling hour.
COACH_HOURLY_CALLS=20

# Hard monthly stop. Once reached, the function refuses until the month turns.
COACH_MONTHLY_COST_CEILING=1.00

# Used only to estimate spend against the ceiling above. Check these against
# Google's current pricing for the model you chose.
GEMINI_INPUT_PRICE_PER_MILLION=0.10
GEMINI_OUTPUT_PRICE_PER_MILLION=0.40

# Kill switch. Set to false to make every call fail fast without calling either provider.
COACH_ENABLED=true
