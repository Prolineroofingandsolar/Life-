# Copy to functions/.env.<projectId> and fill in. Never commit the real file —
# .gitignore already excludes it.
#
# GEMINI_API_KEY is NOT set here. It is a Cloud Functions secret, stored in
# Secret Manager, set once with:
#
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Everything below is ordinary configuration and safe to keep in the env file.

# The exact model identifier from Google's current documentation. Deliberately
# left blank: model names change, and a stale hardcoded one is a future outage.
GEMINI_MODEL=

# Requests allowed per user per rolling hour.
COACH_HOURLY_CALLS=20

# Hard monthly stop. Once reached, the function refuses until the month turns.
COACH_MONTHLY_COST_CEILING=1.00

# Used only to estimate spend against the ceiling above. Check these against
# Google's current pricing for the model you chose.
GEMINI_INPUT_PRICE_PER_MILLION=0.10
GEMINI_OUTPUT_PRICE_PER_MILLION=0.40

# Kill switch. Set to false to make every call fail fast without touching Gemini.
COACH_ENABLED=true
