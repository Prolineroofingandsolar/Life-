{
  "name": "life-functions",
  "description": "Gemini proxy for the Life app's coach. The only place the API key exists.",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "test": "firebase emulators:exec --only firestore --project life-rules-test --config ../firebase.json \"vitest run\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.27.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
